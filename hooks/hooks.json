{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__computer|mcp__claude-in-chrome__form_input|mcp__claude-in-chrome__javascript_tool|mcp__claude-in-chrome__shortcuts_execute|mcp__claude-in-chrome__browser_batch|mcp__claude-in-chrome__upload_image|mcp__claude-in-chrome__file_upload|mcp__claude-in-chrome__tabs_close_mcp|mcp__playwright__browser_click|mcp__playwright__browser_type|mcp__playwright__browser_fill_form|mcp__playwright__browser_select_option|mcp__playwright__browser_file_upload|mcp__playwright__browser_press_key|mcp__playwright__browser_drag|mcp__playwright__browser_evaluate|mcp__playwright__browser_run_code|mcp__playwright__browser_run_code_unsafe|mcp__playwright__browser_handle_dialog|mcp__playwright__browser_network_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/workflow-gate.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__workspace__bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/publish-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/rm-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/flag-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__read_page|mcp__claude-in-chrome__find|mcp__claude-in-chrome__get_page_text|mcp__claude-in-chrome__javascript_tool|mcp__claude-in-chrome__browser_batch|mcp__playwright__browser_snapshot|mcp__playwright__browser_evaluate|mcp__playwright__browser_find|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/injection-warn.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/drop-guard.sh\""
          }
        ]
      }
    ]
  }
}
